{
  "name": "prmpt-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PRMPT as a standalone CLI coding agent: Pi SDK agent loop + live PRMPT file-retrieval tool.",
  "bin": {
    "prmpt": "./dist/index.js"
  },
  "scripts": {
    "prmpt": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.80.2",
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
