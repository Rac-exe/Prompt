# Dependencies
node_modules/
code-intelligence-service/venv/
code-intelligence-service/.venv/
code-intelligence-service/__pycache__/
code-intelligence-service/**/__pycache__/
prmpt-cli/node_modules/
prmpt-cli/dist/

# Legacy (kept for reference, generated artifacts inside are ignored)
legacy/node_modules/
legacy/**/node_modules/
legacy/**/__pycache__/
legacy/**/venv/
legacy/**/.venv/
legacy/**/dist/
legacy/release/

# Build outputs
dist/
build/*.js
build/*.js.map
*.log

# OS files
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# IDE
.vscode/
.idea/
*.iml

# AI Assistant tools (Kilo Code, Claude, Cursor, etc.)
.claude/
.cursor/*
!.cursor/rules/
.agent/
.agents/
.kilocode/

# Supabase CLI cache
supabase/.temp/

# Environment
.env
.env.local
.env.packaged

# Python
*.pyc
*.pyo
*.pyd
.Python
pip-log.txt
pip-delete-this-directory.txt

# Electron
out/
release/

# Built UI files (generated from app-ui/src)
electron/renderer/app-ui/*
!electron/renderer/app-ui/.gitkeep

# App UI source dependencies
app-ui/node_modules/
app-ui/dist/
app-ui/.emergent/

# Machine Learning Models (large files — too big for GitHub)
python-service/vosk-model-*/
python-service/*.pt
python-service/*.pth
python-service/*.onnx
python-service/*.pb
legacy/python-service/vosk-model-*/
legacy/**/*.pt
legacy/**/*.pth

# TypeScript Build Info
*.tsbuildinfo

# Usage Logs
python-service/pipeline_v2/storage/usage/*.jsonl

# Native Rust crates — build artifacts and per-crate node_modules
# (each crate also has its own .gitignore but cover them at the repo level
# so a fresh clone or a deleted/abandoned crate folder never spams git status)
native/**/target/
native/**/node_modules/
.commandcode/taste/taste.md

# Docs (pitch decks, audits, generated assets)
docs/
supabase/migrations/20260516_cron_io_cleanup.sql
