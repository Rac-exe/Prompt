{
  "name": "prompt-optimizer",
  "version": "1.0.0",
  "description": "Global desktop app for AI prompt optimization",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc",
    "electron": "electron .",
    "dev": "npm run build && npm run electron",
    "python:dev": "cd python-service && .\\venv\\Scripts\\python.exe -m uvicorn app.main:app --host 127.0.0.1 --port 8001",
    "python:dev:mac": "cd python-service && ./venv/bin/python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "python:install": "cd python-service && python -m venv venv && .\\venv\\Scripts\\python.exe -m pip install -r requirements.txt",
    "start": "npm run build && npm run electron"
  },
  "keywords": [
    "prompt",
    "optimization",
    "ai",
    "electron",
    "desktop"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.18.1",
    "electron": "^28.0.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "axios": "^1.6.2",
    "node-global-key-listener": "^0.2.0",
    "ws": "^8.19.0"
  }
}
