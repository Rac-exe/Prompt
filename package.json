{
  "name": "prompt-optimizer",
  "version": "1.3.2",
  "description": "Local-first desktop app for AI prompt optimization with codebase-aware context",
  "main": "dist/main/index-new.js",
  "scripts": {
    "native:build": "cd native/platform-core && npm install && npm run build",
    "native:build:mac": "cd native/platform-core && npm install && npm run build",
    "native:build:debug": "cd native/platform-core && npm install && npm run build:debug",
    "install:ui": "cd app-ui && npm install",
    "build:ui": "cd app-ui && npm run build",
    "build:electron": "tsc",
    "build": "npm run build:ui && npm run build:electron",
    "dev:ui": "cd app-ui && npm run dev",
    "electron": "electron .",
    "dev": "npm run build:electron && npm run electron",
    "dev:full": "npm run build && npm run electron",
    "python:dev": "cd python-service && .\\venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --reload-dir app --reload-dir pipeline_v2 --host 127.0.0.1 --port 8001",
    "python:dev:mac": "cd python-service && ./venv/bin/python -m uvicorn app.main:app --reload --reload-dir app --reload-dir pipeline_v2 --host 127.0.0.1 --port 8001",
    "python:install": "cd python-service && python -m venv venv && .\\venv\\Scripts\\python.exe -m pip install -r requirements.txt",
    "python:install:mac": "cd python-service && python3 -m venv venv && ./venv/bin/python -m pip install -r requirements.txt",
    "code-intel:dev": "cd code-intelligence-service && .\\.venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --reload-dir app --host 127.0.0.1 --port 8002",
    "code-intel:dev:mac": "cd code-intelligence-service && ./.venv/bin/python -m uvicorn app.main:app --reload --reload-dir app --host 127.0.0.1 --port 8002",
    "code-intel:install": "cd code-intelligence-service && python -m venv .venv && .\\.venv\\Scripts\\python.exe -m pip install -r requirements.txt",
    "code-intel:install:mac": "cd code-intelligence-service && python3 -m venv .venv && ./.venv/bin/python -m pip install -r requirements.txt",
    "start": "npm run build && npm run electron",
    "package:win": "npm run build && cross-env NODE_OPTIONS=--max-old-space-size=8192 electron-builder --win --x64",
    "package:mac": "npm run build && cross-env NODE_OPTIONS=--max-old-space-size=8192 electron-builder --mac",
    "clean": "rm -rf electron/renderer/app-ui/* dist/",
    "test": "vitest run --config vitest.config.electron.ts",
    "test:unit": "vitest run --config vitest.config.electron.ts tests/unit",
    "test:e2e": "vitest run --config vitest.config.electron.ts tests/e2e",
    "test:watch": "vitest --config vitest.config.electron.ts",
    "test:mock-server": "tsx tests/mocks/python-server.ts",
    "rebuild:native": "electron-builder install-app-deps",
    "postinstall": "node scripts/patch-dev-electron-name.js && electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.prmpt.desktop",
    "productName": "Prmpt",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/platform-core",
        "to": "native/platform-core",
        "filter": [
          "index.js",
          "index.d.ts",
          "platform-core.win32-x64-msvc.node",
          "platform-core.darwin-x64.node",
          "platform-core.darwin-arm64.node",
          "platform-core.darwin-universal.node"
        ]
      },
      {
        "from": "files",
        "to": "files"
      },
      {
        "from": "tree-sitter-wasms",
        "to": "tree-sitter-wasms"
      },
      {
        "from": "build/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "build/tray-iconTemplate.png",
        "to": "tray-iconTemplate.png"
      },
      {
        "from": "build/tray-iconTemplate@2x.png",
        "to": "tray-iconTemplate@2x.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "build/icon.icns",
        "to": "icon.icns"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "forceCodeSigning": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prmpt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "keywords": [
    "prompt",
    "optimization",
    "ai",
    "electron",
    "desktop",
    "rag",
    "local-first"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/express": "^5.0.6",
    "@types/node": "^20.16.0",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "electron": "32.2.7",
    "electron-builder": "^26.8.1",
    "express": "^5.2.1",
    "playwright": "^1.59.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5",
    "ws": "^8.20.0"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "axios": "^1.6.2",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^4.0.3",
    "dotenv": "^16.3.1",
    "file-type": "^16.5.4",
    "tree-sitter-wasms": "0.1.10",
    "uiohook-napi": "^1.5.4",
    "web-tree-sitter": "^0.25.10"
  }
}
