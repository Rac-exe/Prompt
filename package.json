{
  "name": "prompt-optimizer",
  "version": "1.0.0",
  "description": "Global desktop app for AI prompt optimization with Supabase",
  "main": "dist/main/index-new.js",
  "scripts": {
    "native:build": "cd native/windows-core && npm install && npm run build",
    "native:build:debug": "cd native/windows-core && npm install && npm run build:debug",
    "install:ui": "cd app-ui && npm install",
    "build:ui": "cd app-ui && npm run build",
    "build:electron": "tsc",
    "build": "npm run build:ui && npm run build:electron",
    "dev:ui": "cd app-ui && npm run dev",
    "electron": "electron .",
    "dev": "npm run build:electron && npm run electron",
    "dev:full": "npm run build && npm run electron",
    "python:dev": "cd python-service && .\\venv\\Scripts\\python.exe -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8001",
    "python:dev:mac": "cd python-service && ./venv/bin/python -m uvicorn app.main:app --reload --host 127.0.0.1 --port 8001",
    "python:install": "cd python-service && python -m venv venv && .\\venv\\Scripts\\python.exe -m pip install -r requirements.txt",
    "start": "npm run build && npm run electron",
    "package:win": "npm run build && electron-builder --win --x64",
    "supabase:migrate": "supabase db push",
    "clean": "rm -rf electron/renderer/app-ui/* dist/"
  },
  "build": {
    "appId": "com.prmpt.desktop",
    "productName": "Prmpt",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/renderer/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "native/windows-core",
        "to": "native/windows-core",
        "filter": [
          "index.js",
          "index.d.ts",
          "windows-core.win32-x64-msvc.node"
        ]
      },
      {
        "from": "files",
        "to": "files"
      },
      {
        "from": ".env.packaged",
        "to": ".env"
      },
      {
        "from": "build/tray-icon.png",
        "to": "tray-icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prmpt",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "publish": {
      "provider": "generic",
      "url": "https://tfetlkkdggdkbuycfoun.supabase.co/storage/v1/object/public/releases"
    }
  },
  "keywords": [
    "prompt",
    "optimization",
    "ai",
    "electron",
    "desktop",
    "supabase"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/ws": "^8.18.1",
    "electron": "32.2.7",
    "electron-builder": "^26.8.1",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.34.5",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@sentry/electron": "^7.10.0",
    "@supabase/supabase-js": "^2.39.0",
    "active-win": "^8.2.1",
    "axios": "^1.6.2",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^4.0.3",
    "dotenv": "^16.3.1",
    "electron-updater": "^6.8.3",
    "file-type": "^16.5.4",
    "tree-sitter-wasms": "^0.1.13",
    "uiohook-napi": "^1.5.4",
    "web-tree-sitter": "^0.25.10",
    "ws": "^8.19.0"
  }
}
