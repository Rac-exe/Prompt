{
    "name": "windows-core",
    "version": "0.1.0",
    "description": "Win32 native bridge for the Prompt Optimizer Electron app",
    "main": "index.js",
    "scripts": {
        "build": "napi build --platform --release",
        "build:debug": "napi build --platform"
    },
    "napi": {
        "name": "windows-core",
        "triples": {
            "defaults": false,
            "additional": [
                "x86_64-pc-windows-msvc"
            ]
        }
    },
    "devDependencies": {
        "@napi-rs/cli": "^3.6.0"
    },
    "files": [
        "index.js",
        "index.d.ts",
        "*.node"
    ]
}