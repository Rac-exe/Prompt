# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Embeddings + Summarization — only ONE of these is required.
# If OPENAI_API_KEY is set, embeddings go direct to OpenAI.
# Otherwise, embeddings route through OpenRouter.
OPENAI_API_KEY=
OPENROUTER_API_KEY=sk-or-...
SUMMARIZER_MODEL=openrouter/anthropic/claude-3-haiku

# GitHub (Phase 2 webhooks)
GITHUB_WEBHOOK_SECRET=whsec_...

# Redis (async worker queue)
REDIS_URL=redis://localhost:6379

# CORS — comma-separated list of allowed origins (empty = allow all in dev)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# App
APP_ENV=development
APP_VERSION=0.0.1-dev
SENTRY_DSN=

# Server
HOST=0.0.0.0
PORT=8002
