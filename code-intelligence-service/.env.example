# Code-intelligence service (runs locally on 127.0.0.1:8002).
# Everything here is optional: the desktop app sends your OpenRouter key and
# chosen RAG model with every request.

# Only needed when calling the service directly (scripts, curl) without the app.
OPENROUTER_API_KEY=

# Where project indexes are stored. The desktop app also announces its own
# folder via the X-Prmpt-Code-Intel-Root header; leave empty to use that.
CODE_INTEL_DB_ROOT=

# Agentic multi-hop retrieval for Ask/Bug/Optimize (Find mode never uses it).
# On by default; each Ask/Bug query makes LLM calls. Set false for one-shot RAG.
AGENTIC_RETRIEVAL_ENABLED=true

# Knowledge-graph pipeline (PageRank, communities) after each index.
GRAPH_BUILDER_ENABLED=true

# Default models (OpenRouter ids in litellm form). The RAG model chosen in the
# app overrides ANSWER_MODEL and AGENT_MODEL; the rest are small helper models.
# ANSWER_MODEL=openrouter/deepseek/deepseek-chat
# AGENT_MODEL=openrouter/deepseek/deepseek-chat
# SUMMARIZER_MODEL=openrouter/deepseek/deepseek-chat
# QUERY_DECOMPOSE_MODEL=openrouter/openai/gpt-4o-mini
# QUERY_REFINER_MODEL=openrouter/deepseek/deepseek-chat

# Extra origins allowed to call the API from a browser (comma-separated).
# Leave empty: the desktop app does not need any.
ALLOWED_ORIGINS=

APP_ENV=development
PORT=8002
