      "branch":                "optional branch filter",
      "expected_files":        "list of file paths at least one of which MUST appear in ranked probable_locations",
      "expected_line_range":   "optional [start,end]; used only for IoU on the first match",
      "expected_concepts":     "optional list; at least one should appear in response.concepts",
      "expected_intent":       "optional; compared to response.intent"
    }
  },
