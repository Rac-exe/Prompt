# ── PRMPT CLI ─────────────────────────────────────────────────────────────────
# Copy this to .env and fill in your values.
# Never commit .env to git.

# ── LLM Provider ──────────────────────────────────────────────────────────────
# OpenRouter (recommended) → https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Anthropic direct (optional fallback)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── PRMPT CLI Model ───────────────────────────────────────────────────────────
# The model the CLI agent uses for coding tasks
PRMPT_MODEL=openrouter/anthropic/claude-sonnet-4-5
PRMPT_MAX_TOKENS=8096

# ── Code Intelligence Service ─────────────────────────────────────────────────
# Runs locally on port 8002 — powers file retrieval
CODE_INTELLIGENCE_SERVICE_URL=http://127.0.0.1:8002

# Dev auth bypass for local code-intel (keeps Supabase optional in dev)
PRMPT_ALLOW_DEV_CLI_AUTH=1
PRMPT_DEV_AUTH_TOKEN=dev-cli-token
PRMPT_DEV_USER_ID=

# ── Code Intel Internal Models ────────────────────────────────────────────────
# Used by code-intelligence-service for summarization and query decomposition
# See code-intelligence-service/.env.example for full list
OPENAI_API_KEY=sk-your-openai-key-here

# ── App Environment ───────────────────────────────────────────────────────────
APP_ENV=development

# ── Observability (optional) ──────────────────────────────────────────────────
# PRMPT_LLM_USAGE_LOG=./prmpt-cli/harness/results/llm_usage.jsonl
