# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Python Service Configuration
PYTHON_SERVICE_URL=http://127.0.0.1:8001

# Supabase JWT Secret — from Supabase dashboard → Project Settings → API → JWT Secret
# Required in production to authenticate Python service requests.
# Leave empty in local dev to skip auth (warning will be logged).
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Allowed origins for Python service CORS (comma-separated, or * for all)
ALLOWED_ORIGINS=*

# ── API Keys ────────────────────────────────────────────────────────────────
# OpenRouter → https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Deepgram → https://console.deepgram.com  (real-time streaming transcription)
# Required on the Python service for voice input.
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# ── Model Configuration ─────────────────────────────────────────────────────
# Main optimizer (prompt optimization, streaming)
OPTIMIZER_MODEL=openrouter/anthropic/claude-haiku-4.5
# Cheap model for summarization, title generation, memory extraction
SUMMARIZER_MODEL=openrouter/openai/gpt-4o-mini

# ── Cloudinary (file uploads) ────────────────────────────────────────────────
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-upload-preset
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ── App Environment ───────────────────────────────────────────────────────────
# Controls Sentry environment tag. Set to "production" in prod builds.
NODE_ENV=development
APP_ENV=development

# ── Sentry ────────────────────────────────────────────────────────────────────
# Create a project at https://sentry.io and grab the DSN from Project Settings → Client Keys
SENTRY_DSN=https://your-key@oXXXXXX.ingest.us.sentry.io/XXXXXXX
VITE_SENTRY_DSN=https://your-key@oXXXXXX.ingest.us.sentry.io/XXXXXXX
SENTRY_PYTHON_DSN=https://your-key@oXXXXXX.ingest.us.sentry.io/XXXXXXX
# Required for source-map upload on production builds (Settings → Auth Tokens)
SENTRY_AUTH_TOKEN=sntrys_your_token_here
SENTRY_ORG=your-sentry-org-slug
SENTRY_PROJECT=your-sentry-project-slug
