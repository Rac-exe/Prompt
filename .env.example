# Prmpt runs entirely on your machine. Everything in this file is optional.
# Copy it to .env (repo root) to override defaults. It is read by the Electron
# app and the Python optimizer service.

# ── Local services ───────────────────────────────────────────────────────────
# Where the desktop app finds the two local Python services.
PYTHON_SERVICE_URL=http://127.0.0.1:8001
CODE_INTELLIGENCE_SERVICE_URL=http://127.0.0.1:8002

# ── API keys ─────────────────────────────────────────────────────────────────
# Not needed for the desktop app: you enter your OpenRouter key (and optional
# Deepgram key) in the app, at first launch or in Settings > AI provider.
# These are only fallbacks for calling the services directly (scripts, curl).
# OpenRouter → https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Deepgram → https://console.deepgram.com (voice input)
DEEPGRAM_API_KEY=

# ── Models (optimizer service) ───────────────────────────────────────────────
# The optimizer model chosen in the app overrides OPTIMIZER_MODEL. The small
# helper model is used for titles, summaries and memory extraction.
# OPTIMIZER_MODEL=openrouter/openai/gpt-4o-mini
# SUMMARIZER_MODEL=openrouter/openai/gpt-4o-mini

# Extra origins allowed to call the optimizer API from a browser
# (comma-separated). Leave empty: the desktop app does not need any.
ALLOWED_ORIGINS=

NODE_ENV=development
APP_ENV=development
